{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx *)"
    ],
    "ask": [
      "Bash(npx skills add *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(git commit *)",
      "Bash(supabase db reset *)",
      "Bash(supabase db push *)",
      "Bash(terraform destroy *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.js\""
          }
        ]
      }
    ]
  }
}
